{
    email {$CADDY_ACME_EMAIL}
    on_demand_tls {
        ask http://127.0.0.1:8080/_internal/caddy/allow-domain
    }
}

# Main platform domain: normal managed certificate.
edumanage.leosoftug.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
}

# EduManage-managed school subdomains use the existing wildcard DNS pattern.
# Caddy obtains certificates as each registered hostname is first used.
https://*.schools.leosoftug.com {
    tls {
        on_demand
    }
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
}

# Client-owned custom domains. The empty HTTPS address accepts arbitrary SNI,
# but certificate issuance is restricted by the global ask endpoint above.
https:// {
    tls {
        on_demand
    }
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
}
